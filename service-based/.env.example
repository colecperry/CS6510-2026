DATABASE_URL=postgresql://checkout:checkout@localhost:5436/self_checkout
LOW_STOCK_DEFAULT_THRESHOLD=50
POPULARITY_SNAPSHOT_CAP=100

# Where the gateway forwards to. Only the gateway reads these; no domain service knows another service's address.
CHECKOUT_URL=http://localhost:8081
INVENTORY_URL=http://localhost:8082
ANALYTICS_URL=http://localhost:8083

# Database connections per service. The previous weeks gave one process 120 against a server limit of 200. Three processes each taking 120 would exhaust it, so the allowance is split by traffic: checkout serves almost everything, the other two answer once per run.
CHECKOUT_POOL_MAX=100
INVENTORY_POOL_MAX=10
ANALYTICS_POOL_MAX=10

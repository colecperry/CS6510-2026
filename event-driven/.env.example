# One database URL per service. Each service is given only its own: checkout holds no credentials that reach inventory's data, which is what makes "each service owns its store" a boundary rather than a promise.
CHECKOUT_DATABASE_URL=postgresql://checkout:checkout@localhost:5440/self_checkout
INVENTORY_DATABASE_URL=postgresql://checkout:checkout@localhost:5441/self_checkout
ANALYTICS_DATABASE_URL=postgresql://checkout:checkout@localhost:5442/self_checkout

# The broker, and the only address any service holds besides its own database. Note what is absent: no service has another service's host or port, because none of them can call each other any more.
BROKER_URL=amqp://guest:guest@localhost:5672/

LOW_STOCK_DEFAULT_THRESHOLD=50
POPULARITY_SNAPSHOT_CAP=100

# Where the edge forwards to. Read by the gateway alone, and by nginx through its own config file; no service reads these.
CHECKOUT_URL=http://localhost:8081
INVENTORY_URL=http://localhost:8082
ANALYTICS_URL=http://localhost:8083

# How often checkout looks for messages it has committed to sending but not yet sent. A shopper never waits on this, so it is tuned for how quickly stock catches up rather than for request latency.
OUTBOX_POLL_MS=50

# The scan path. Scans pile up in memory and are published in batches, so a shopper's request never touches the network. Above this many waiting, new scans are shed rather than blocking the sale.
SCAN_BATCH_MAX=200
SCAN_QUEUE_MAX=50000

# Database connections per service. Checkout still takes nearly all the traffic; inventory now writes once per sale and reads for low-stock, so it needs fewer than when it was called synchronously.
CHECKOUT_POOL_MAX=100
INVENTORY_POOL_MAX=20
ANALYTICS_POOL_MAX=10

# One database URL per service. Each service is given only its own: checkout holds no credentials that reach inventory's data, which is what makes "each service owns its store" a boundary rather than a promise.
CHECKOUT_DATABASE_URL=postgresql://checkout:checkout@localhost:5437/self_checkout
INVENTORY_DATABASE_URL=postgresql://checkout:checkout@localhost:5438/self_checkout
ANALYTICS_DATABASE_URL=postgresql://checkout:checkout@localhost:5439/self_checkout

LOW_STOCK_DEFAULT_THRESHOLD=50
POPULARITY_SNAPSHOT_CAP=100

# Where the gateway forwards to. The gateway reads all three; no service reads another's entry here.
CHECKOUT_URL=http://localhost:8081
INVENTORY_URL=http://localhost:8082
ANALYTICS_URL=http://localhost:8083

# Checkout is the only service that calls another, because paying has to reduce stock that inventory owns. It reads these two and nothing else does.
CHECKOUT_INVENTORY_URL=http://localhost:8082
CHECKOUT_ANALYTICS_URL=http://localhost:8083

# How long checkout keeps retrying inventory during a payment before giving up and refusing it. Held well under the load client's 10s per-request timeout, so a failure comes back as a refusal we can explain rather than a request the client abandoned.
CHECKOUT_STOCK_CALL_TIMEOUT_MS=500
CHECKOUT_STOCK_RETRY_BUDGET_MS=2000

# Database connections per service. Each now has its own server, so they no longer share one allowance; these are sized to the traffic each actually takes.
CHECKOUT_POOL_MAX=100
INVENTORY_POOL_MAX=20
ANALYTICS_POOL_MAX=10
